{
  "openapi": "3.0.3",
  "info": {
    "title": "Love Admin CMS Service API",
    "version": "0.3.0",
    "description": "Love Admin CMS 后端接口文档。后台接口统一使用 Authorization: Bearer <token>。"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "Keyword": {
        "name": "keyword",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "Status": {
        "name": "status",
        "in": "query",
        "schema": {
          "type": "integer",
          "enum": [0, 1, 2]
        }
      }
    },
    "responses": {
      "Success": {
        "description": "操作成功",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Response"
            }
          }
        }
      },
      "Created": {
        "description": "创建成功",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Response"
            }
          }
        }
      },
      "Empty": {
        "description": "操作成功",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Response"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "未登录或 token 无效"
      },
      "Forbidden": {
        "description": "权限不足"
      },
      "NotFound": {
        "description": "资源不存在"
      }
    },
    "schemas": {
      "Response": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "查询成功"
          },
          "data": {}
        }
      },
      "ArticlePayload": {
        "type": "object",
        "required": ["article_title", "article_cont"],
        "properties": {
          "category_id": {
            "type": "integer",
            "minimum": 0
          },
          "article_title": {
            "type": "string",
            "maxLength": 120
          },
          "article_cont": {
            "type": "string"
          },
          "article_pic": {
            "type": "string"
          },
          "article_summary": {
            "type": "string",
            "maxLength": 500
          },
          "article_slug": {
            "type": "string",
            "maxLength": 120
          },
          "seo_title": {
            "type": "string",
            "maxLength": 120
          },
          "seo_keywords": {
            "type": "string",
            "maxLength": 255
          },
          "seo_description": {
            "type": "string",
            "maxLength": 255
          },
          "tag_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "status": {
            "type": "integer",
            "enum": [0, 1, 2],
            "description": "0 草稿，1 发布，2 删除"
          },
          "is_top": {
            "type": "integer",
            "enum": [0, 1]
          },
          "is_recommend": {
            "type": "integer",
            "enum": [0, 1]
          },
          "sort": {
            "type": "integer"
          }
        }
      },
      "TagPayload": {
        "type": "object",
        "properties": {
          "tag_title": {
            "type": "string",
            "maxLength": 30
          },
          "status": {
            "type": "integer",
            "enum": [0, 1, 2]
          }
        }
      },
      "CategoryPayload": {
        "type": "object",
        "properties": {
          "category_name": {
            "type": "string",
            "maxLength": 30
          },
          "category_slug": {
            "type": "string",
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 255
          },
          "sort": {
            "type": "integer"
          },
          "status": {
            "type": "integer",
            "enum": [0, 1, 2]
          }
        }
      },
      "NavPayload": {
        "type": "object",
        "properties": {
          "nav_name": {
            "type": "string",
            "maxLength": 30
          },
          "nav_url": {
            "type": "string",
            "maxLength": 255
          },
          "nav_icon": {
            "type": "string",
            "maxLength": 255
          },
          "target": {
            "type": "string",
            "enum": ["_self", "_blank"]
          },
          "sort": {
            "type": "integer"
          },
          "status": {
            "type": "integer",
            "enum": [0, 1, 2]
          }
        }
      },
      "FriendLinkPayload": {
        "type": "object",
        "properties": {
          "friendlink_title": {
            "type": "string",
            "maxLength": 60
          },
          "friendlink_url": {
            "type": "string",
            "format": "uri"
          },
          "friendlink_logo": {
            "type": "string",
            "maxLength": 255
          },
          "status": {
            "type": "integer",
            "enum": [0, 1, 2]
          }
        }
      },
      "SettingPayload": {
        "type": "object",
        "properties": {
          "setting_key": {
            "type": "string",
            "maxLength": 80
          },
          "setting_value": {},
          "value_type": {
            "type": "string",
            "enum": ["string", "number", "boolean", "json"]
          },
          "remark": {
            "type": "string",
            "maxLength": 255
          },
          "is_public": {
            "type": "integer",
            "enum": [0, 1]
          }
        }
      },
      "UserPayload": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128
          },
          "nickname": {
            "type": "string",
            "maxLength": 20
          },
          "realname": {
            "type": "string",
            "maxLength": 20
          },
          "avatar": {
            "type": "string",
            "maxLength": 255
          },
          "sex": {
            "type": "integer"
          },
          "birthday": {
            "type": "integer"
          },
          "github_nickname": {
            "type": "string"
          },
          "github_link": {
            "type": "string"
          },
          "qq_nickname": {
            "type": "string"
          },
          "qq_link": {
            "type": "string"
          },
          "music_nickname": {
            "type": "string"
          },
          "music_link": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "editor", "user"]
          },
          "status": {
            "type": "integer",
            "enum": [0, 1, 2]
          }
        }
      },
      "PasswordPayload": {
        "type": "object",
        "required": ["password"],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128
          }
        }
      },
      "AuthPasswordPayload": {
        "type": "object",
        "required": ["password", "newPassword"],
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128
          }
        }
      },
      "UploadPayload": {
        "type": "object",
        "properties": {
          "mime": {
            "type": "string",
            "example": "image/png"
          },
          "content": {
            "type": "string",
            "description": "base64 内容"
          },
          "dataUrl": {
            "type": "string",
            "description": "data:image/png;base64,..."
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "健康检查",
        "tags": ["System"],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI JSON",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "OpenAPI 文档"
          }
        }
      }
    },
    "/docs": {
      "get": {
        "summary": "Swagger UI 页面",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Swagger UI HTML"
          }
        }
      }
    },
    "/docs/assets/{file}": {
      "get": {
        "summary": "Swagger UI 静态资源",
        "tags": ["System"],
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
